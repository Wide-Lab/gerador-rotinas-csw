  "ruleHooks": {
    "extraMethods": "; Obter Tabela de Tipo Requisicao\n;\n; set sc=$$ObterTabTipoRequisicao^WDOMREQ100RG(.tabTipoRequisicao)\nObterTabTipoRequisicao(tabOpcoes)\t;\n$$$VAR\n;\nkill tabOpcoes\n;\nset tabOpcoes(\"T\")=\"T-Independente de Transferência\"\nset tabOpcoes(\"S\")=\"S-Independente de Saída\"\nset tabOpcoes(\"O\")=\"O-Requisição de OF\"\nset tabOpcoes(\"C\")=\"C-Complementar de OF\"\n;\nquit $$$OK\n;\n; Obter Tabela de Situacao Requisicao\n;\n; set sc=$$ObterTabSituacaoRequisicao^WDOMREQ100RG(.tabSituacaoRequisicao)\nObterTabSituacaoRequisicao(tabOpcoes)\t;\n$$$VAR\n;\nkill tabOpcoes\n;\nset tabOpcoes(\"A\")=\"A-Aberto\"\nset tabOpcoes(\"T\")=\"T-Atendido\"\n;\nquit $$$OK\n;\n; Obter Tabela de Status Requisicao\n;\n; set sc=$$ObterTabStatusRequisicao^WDOMREQ100RG(.tabStatusRequisicao)\nObterTabStatusRequisicao(tabOpcoes)\t;\n$$$VAR\n;\nkill tabOpcoes\n;\nset tabOpcoes(\"1\")=\"1-Aberto\"\nset tabOpcoes(\"2\")=\"2-Aguardando\"\nset tabOpcoes(\"3\")=\"3-Separação\"\nset tabOpcoes(\"4\")=\"4-Separado\"\nset tabOpcoes(\"5\")=\"5-Baixado\"\n;\nquit $$$OK\n;\n; Obter Tabela de Solicitante\n;\n; set sc=$$ObterTabSolicitante^WDOMREQ100RG(.tabSolicitante)\nObterTabSolicitante(tabSolicitante)\t;\n$$$VAR\nnew codigo\n;\nkill tabSolicitante\n;\nset codigo=\"\"\nfor  set codigo=$order(^%CSMENOP(codigo)) quit:codigo=\"\"  set tabSolicitante(codigo)=codigo_\"-\"_$piece($get(^%CSMENOP(codigo)),Z,1)\n;\nquit $$$OK\n;\n; Obter Tabela de Local Entrega\n;\n; set sc=$$ObterTabLocalEntrega^WDOMREQ100RG(codEmpresa,.tabLocalEntrega)\nObterTabLocalEntrega(codEmpresa,tabLocalEntrega)\t;\n$$$VAR\nnew codigo\n;\nkill tabLocalEntrega\n;\nset codigo=\"\"\nfor  set codigo=$order(^ESMMAQ(codEmpresa,1,codigo)) quit:codigo=\"\"  set tabLocalEntrega(codigo)=codigo_\"-\"_$piece($get(^ESMMAQ(codEmpresa,1,codigo)),Z,1)\n;\nquit $$$OK\n;\n; Obter Tabela de Natureza\n;\n; set sc=$$ObterTabNatureza^WDOMREQ100RG(codEmpresa,.tabNatureza)\nObterTabNatureza(codEmpresa,tabNatureza)\t;\n$$$VAR\nnew codigo\n;\nkill tabNatureza\n;\nset codigo=\"\"\nfor  set codigo=$order(^ESANAT(codEmpresa,codigo)) quit:codigo=\"\"  set tabNatureza(codigo)=codigo_\"-\"_$piece($get(^ESANAT(codEmpresa,codigo)),Z,1)\n;\nquit $$$OK\n;"
  }
