  "ruleHooks": {
    "deleteValidation": "set sc=$$ValidarVinculoReceita(codEmpresa,codPrograma)\nif $$$ISERR(sc) quit sc",
    "extraMethods": "; Validar Vínculo com Receita\n;\n; set sc=$$ValidarVinculoReceita^WDOMTESTETIRG(codEmpresa,codPrograma)\nValidarVinculoReceita(codEmpresa,codPrograma)\t;\n$$$VAR\nnew codReceita,seqComponente,codVinculo\n;\nset (codReceita,codVinculo)=\"\"\nfor  set codReceita=$order(^TTRREC(codEmpresa,codReceita)) quit:codReceita=\"\"!(codVinculo'=\"\")  do\n. set seqComponente=\"\"\n. for  set seqComponente=$order(^TTRREC(codEmpresa,codReceita,seqComponente)) quit:seqComponente=\"\"!(codVinculo'=\"\")  do\n. . if $piece($get(^TTRREC(codEmpresa,codReceita,seqComponente)),Z,6)=codPrograma set codVinculo=codReceita\n;\nif codVinculo'=\"\" quit $$$ERROR(10000,\"Programa \"_codPrograma_\" vinculado à receita \"_codVinculo_\"! Exclusão não permitida.\")\n;\nquit $$$OK\n;\n; Obter Descrição da Observação\n;\n; set descricao=$$ObterDescricaoObservacao^WDOMTESTETIRG(codEmpresa,codObservacao)\nObterDescricaoObservacao(codEmpresa,codObservacao)\t;\n$$$VAR\nnew sc,ttgtab14\n;\nif $get(codObservacao)=\"\" quit \"\"\nset sc=$$VerObservacao^CCTTGRG001(codEmpresa,codObservacao,.ttgtab14)\nif $$$ISERR(sc) quit \"\"\n;\nquit $piece(ttgtab14,Z,1)\n;\n; Obter Descrição do Item\n;\n; set descricao=$$ObterDescricaoItem^WDOMTESTETIRG(codItem)\nObterDescricaoItem(codItem)\t;\n$$$VAR\nnew sc,cgigen\n;\nif $get(codItem)=\"\" quit \"\"\nset sc=$$VerItem^CCCGIRG001(codItem,.cgigen)\nif $$$ISERR(sc) quit \"\"\n;\nquit $piece(cgigen,Z,1)"
  }
